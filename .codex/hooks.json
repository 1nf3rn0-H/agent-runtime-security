    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/harshmehta/Desktop/Projects/AiDR/.aidr/codex_hook.py --rules /Users/harshmehta/Desktop/Projects/AiDR/.aidr/rules.json",
