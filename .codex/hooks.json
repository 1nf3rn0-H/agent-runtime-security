{
  "description": "Agent Runtime Security policy and correlation hooks for every supported local tool in this workspace.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 .agent-runtime-security/codex_hook.py --rules .agent-runtime-security/rules.json",
            "timeout": 2,
            "statusMessage": "Agent Runtime Security is starting session tracing"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 .agent-runtime-security/codex_hook.py --rules .agent-runtime-security/rules.json",
            "timeout": 2,
            "statusMessage": "Agent Runtime Security is linking the subagent trace"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 .agent-runtime-security/codex_hook.py --rules .agent-runtime-security/rules.json",
            "timeout": 2,
            "statusMessage": "Agent Runtime Security is checking the pending tool action"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 .agent-runtime-security/codex_hook.py --rules .agent-runtime-security/rules.json",
            "timeout": 2,
            "statusMessage": "Agent Runtime Security is checking the permission request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 .agent-runtime-security/codex_hook.py --rules .agent-runtime-security/rules.json",
            "timeout": 2,
            "statusMessage": "Agent Runtime Security is recording tool completion"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 .agent-runtime-security/codex_hook.py --rules .agent-runtime-security/rules.json",
            "timeout": 2,
            "statusMessage": "Agent Runtime Security is finalizing session telemetry"
          }
        ]
      }
    ]
  }
}
