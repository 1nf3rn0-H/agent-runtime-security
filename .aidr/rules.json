{
  "policy_ir_version": "1.4.0",
  "trace": {
    "state_dir": ".aidr/state",
    "inject_shell_environment": true
  },
  "telemetry": {
    "path": ".aidr/events.jsonl",
    "include_raw_command": true
  },
  "detections": {
    "path": ".aidr/detections.jsonl",
    "emit_actions": [
      "deny"
    ]
  },
  "threat_intelligence": {
    "enabled": false,
    "provider": "virustotal",
    "api_key_env": "VIRUSTOTAL_API_KEY",
    "timeout_ms": 1500,
    "failure_mode": "open",
    "malicious_threshold": 1,
    "suspicious_threshold": 1,
    "max_lookups": 4
  },
  "default_action": "allow",
  "compiler": {
    "language": "aidrql/2",
    "source": "policies/default.aidrql"
  },
  "rules": [
    {
      "id": "block-ping-evil-domain",
      "title": "Network probing of a prohibited domain",
      "severity": "high",
      "category": "network.prohibited_destination",
      "version": "1",
      "action": "deny",
      "match": {
        "case_sensitive": false,
        "conditions": [
          {
            "field": "tool.name",
            "operator": "==",
            "value": "Bash"
          },
          {
            "field": "process.executable",
            "operator": "IN",
            "value": [
              "ping",
              "ping6"
            ]
          },
          {
            "field": "network.destinations",
            "operator": "ANY_MATCHES",
            "value": "^evil\\.com$"
          }
        ]
      },
      "description": "Prevent an agent from invoking ping against an explicitly prohibited domain.",
      "message": "Blocked by AiDR: ping destination matched a prohibited-domain policy."
    },
    {
      "id": "block-virustotal-malicious-destination",
      "title": "VirusTotal malicious network destination",
      "severity": "high",
      "category": "network.threat_intelligence",
      "version": "1",
      "action": "deny",
      "match": {
        "case_sensitive": false,
        "conditions": [
          {
            "field": "tool.name",
            "operator": "==",
            "value": "Bash"
          },
          {
            "field": "process.executable",
            "operator": "IN",
            "value": [
              "curl",
              "ping",
              "ping6",
              "wget"
            ]
          },
          {
            "field": "network.destinations",
            "operator": "ANY_MATCHES",
            "value": "^evil\\.com$"
          },
          {
            "field": "threat.verdicts",
            "operator": "HAS_ANY",
            "value": [
              "malicious"
            ]
          }
        ]
      },
      "description": "Look up regex-selected network destinations and deny those classified as malicious by VirusTotal.",
      "message": "Blocked by AiDR: VirusTotal classified the destination as malicious."
    },
    {
      "id": "audit-all-shell-commands",
      "title": "Audit shell command",
      "severity": "informational",
      "category": "execution.shell_command",
      "version": "1",
      "action": "audit",
      "match": {
        "case_sensitive": false,
        "conditions": [
          {
            "field": "tool.name",
            "operator": "==",
            "value": "Bash"
          }
        ]
      },
      "description": "Record every shell command without changing its decision."
    }
  ]
}
